
<%@ page import="it.web.routex.domain.SessionAuthUtil" %>
<%@ page import="it.web.routex.controller.applicativo.UserProfileControllerApplicativo" %>
<%@ page import="it.web.routex.model.UserProfile" %>
<%
    HttpSession routexHeaderSession = request.getSession(false);

    String routexHeaderNome = null;
    String routexHeaderCognome = null;
    String routexHeaderRuolo = null;
    String routexHeaderCodiceFiscale = null;
    boolean routexHeaderHasAvatar = false;

    if (SessionAuthUtil.isLoggedIn(routexHeaderSession)) {
        routexHeaderNome = (String) routexHeaderSession.getAttribute("nome");
        routexHeaderCognome = (String) routexHeaderSession.getAttribute("cognome");
        routexHeaderCodiceFiscale = (String) routexHeaderSession.getAttribute("codiceFiscale");
        Object ruoloObj = routexHeaderSession.getAttribute("ruolo");
        if (ruoloObj != null) {
            routexHeaderRuolo = ruoloObj.toString();
        }

        try {
            UserProfile routexHeaderProfile = new UserProfileControllerApplicativo().getProfile(routexHeaderCodiceFiscale);
            routexHeaderHasAvatar = routexHeaderProfile.isAvatarPresent();
        } catch (Exception ignored) {
            routexHeaderHasAvatar = false;
        }
    }

    String routexHeaderInitials = "";
    if (routexHeaderNome != null && !routexHeaderNome.isBlank()) {
        routexHeaderInitials += routexHeaderNome.trim().substring(0, 1).toUpperCase();
    }
    if (routexHeaderCognome != null && !routexHeaderCognome.isBlank()) {
        routexHeaderInitials += routexHeaderCognome.trim().substring(0, 1).toUpperCase();
    }
    if (routexHeaderInitials.isBlank()) {
        routexHeaderInitials = "SF";
    }
%>

<% if (routexHeaderNome != null && routexHeaderCognome != null && routexHeaderRuolo != null) { %>
    <div class="app-user-menu"
         style="position:fixed;top:14px;right:16px;z-index:3000;">
        <button class="app-user-avatar-button"
                type="button"
                aria-haspopup="true"
                aria-expanded="false"
                aria-label="Open user menu: <%= routexHeaderNome %> <%= routexHeaderCognome %>, <%= routexHeaderRuolo %>"
                title="<%= routexHeaderNome %> <%= routexHeaderCognome %> - <%= routexHeaderRuolo %>"
                style="width:38px!important;height:38px!important;min-width:38px!important;max-width:38px!important;min-height:38px!important;max-height:38px!important;padding:0!important;margin:0!important;border-radius:50%!important;overflow:hidden!important;display:grid!important;place-items:center!important;background:#0e7c66!important;color:#fff!important;border:2px solid #fff!important;box-shadow:0 8px 22px rgba(19,35,28,.18)!important;cursor:pointer!important;font:800 12px Arial,sans-serif!important;line-height:1!important;">
            <% if (routexHeaderHasAvatar) { %>
            <img src="profileAvatar?t=<%= System.currentTimeMillis() %>" alt="" style="width:38px!important;height:38px!important;min-width:38px!important;max-width:38px!important;min-height:38px!important;max-height:38px!important;display:block!important;object-fit:cover!important;border-radius:50%!important;">
            <% } else { %>
            <span><%= routexHeaderInitials %></span>
            <% } %>
        </button>

        <div class="app-user-dropdown"
             hidden
             style="position:absolute!important;top:46px!important;right:0!important;width:240px!important;padding:6px 0!important;border-radius:8px!important;background:#fff!important;border:1px solid #d0d7de!important;box-shadow:0 12px 28px rgba(31,35,40,.16)!important;color:#24292f!important;overflow:hidden!important;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Arial,sans-serif!important;">
            <div class="app-user-dropdown__account" style="padding:9px 12px 10px!important;border-bottom:1px solid #d8dee4!important;background:#fff!important;">
                <strong style="display:block!important;max-width:210px!important;overflow:hidden!important;text-overflow:ellipsis!important;white-space:nowrap!important;color:#24292f!important;font-size:14px!important;line-height:18px!important;font-weight:600!important;"><%= routexHeaderNome %> <%= routexHeaderCognome %></strong>
                <small style="display:block!important;margin-top:2px!important;color:#57606a!important;font-size:12px!important;line-height:16px!important;font-weight:400!important;text-transform:uppercase!important;"><%= routexHeaderRuolo %></small>
            </div>
            <a class="app-user-dropdown__item" href="profile" style="display:flex!important;align-items:center!important;gap:10px!important;padding:8px 12px!important;color:#24292f!important;background:#fff!important;text-decoration:none!important;font-size:14px!important;line-height:20px!important;font-weight:400!important;">
                <span class="app-user-dropdown__icon" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="16" height="16">
                        <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm0 1.5c-3.1 0-5.5 1.4-5.5 3.2 0 .5.4.8.9.8h9.2c.5 0 .9-.3.9-.8 0-1.8-2.4-3.2-5.5-3.2Z"></path>
                    </svg>
                </span>
                <span>Impostazioni profilo</span>
            </a>
            <div class="app-user-dropdown__divider" style="height:1px!important;margin:6px 0!important;background:#d8dee4!important;"></div>
            <a href="logout" class="app-user-dropdown__item app-user-dropdown__logout" style="display:flex!important;align-items:center!important;gap:10px!important;padding:8px 12px!important;color:#24292f!important;background:#fff!important;text-decoration:none!important;font-size:14px!important;line-height:20px!important;font-weight:400!important;">
                <span class="app-user-dropdown__icon" aria-hidden="true">
                    <svg viewBox="0 0 16 16" width="16" height="16">
                        <path d="M3 2.75A1.75 1.75 0 0 1 4.75 1h3.5a.75.75 0 0 1 0 1.5h-3.5a.25.25 0 0 0-.25.25v10.5c0 .14.11.25.25.25h3.5a.75.75 0 0 1 0 1.5h-3.5A1.75 1.75 0 0 1 3 13.25V2.75Zm8.47 3.22a.75.75 0 0 1 1.06 0l1.5 1.5a.75.75 0 0 1 0 1.06l-1.5 1.5a.75.75 0 1 1-1.06-1.06l.22-.22H7.75a.75.75 0 0 1 0-1.5h3.94l-.22-.22a.75.75 0 0 1 0-1.06Z"></path>
                    </svg>
                </span>
                <span>Logout</span>
            </a>
        </div>
    </div>
    <script>
        (function () {
            const menu = document.currentScript.previousElementSibling;
            if (!menu) {
                return;
            }

            const button = menu.querySelector(".app-user-avatar-button");
            const dropdown = menu.querySelector(".app-user-dropdown");
            if (!button || !dropdown) {
                return;
            }

            button.addEventListener("click", function (event) {
                event.stopPropagation();
                const isOpen = !dropdown.hasAttribute("hidden");
                dropdown.toggleAttribute("hidden", isOpen);
                button.setAttribute("aria-expanded", String(!isOpen));
            });

            document.addEventListener("click", function (event) {
                if (!menu.contains(event.target)) {
                    dropdown.setAttribute("hidden", "");
                    button.setAttribute("aria-expanded", "false");
                }
            });

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape") {
                    dropdown.setAttribute("hidden", "");
                    button.setAttribute("aria-expanded", "false");
                }
            });

            dropdown.querySelectorAll(".app-user-dropdown__item").forEach(function (item) {
                item.addEventListener("mouseenter", function () {
                    item.style.background = "#0969da";
                    item.style.color = "#ffffff";
                    item.querySelectorAll("svg").forEach(function (svg) {
                        svg.style.fill = "#ffffff";
                    });
                });
                item.addEventListener("mouseleave", function () {
                    item.style.background = "#ffffff";
                    item.style.color = "#24292f";
                    item.querySelectorAll("svg").forEach(function (svg) {
                        svg.style.fill = "#57606a";
                    });
                });
            });
        }());
    </script>
<% } %>
